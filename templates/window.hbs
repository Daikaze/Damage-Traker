<section class="dt-ui">
  <header class="dt-head">
    <div>
      <h1>Damage Hall of Fame</h1>
      <p>Track the heroes who hit the hardest</p>
    </div>
    <div class="dt-live">
      <label class="dt-switch" title="Turn automatic damage tracking on or off">
        <input type="checkbox" data-tracking {{#if tracking}}checked{{/if}} {{#unless isGM}}disabled{{/unless}}>
        <span class="dt-switch-track"></span>
      </label>
      <strong class="{{#if tracking}}is-on{{else}}is-off{{/if}}">TRACKING {{#if tracking}}ON{{else}}OFF{{/if}}</strong>
    </div>
  </header>
  <nav class="dt-tabs">
    <div class="dt-metrics">
      <button type="button" data-metric="hit" class="{{#if hit}}active{{/if}}">⚔ Highest Hit</button>
      <button type="button" data-metric="total" class="{{#if total}}active{{/if}}">🔥 Total Damage</button>
      <button type="button" data-metric="round" class="{{#if round}}active{{/if}}">✦ Best Round</button>
    </div>
    <div class="dt-filters">
      <button type="button" class="dt-players-tab {{#if showPlayers}}active{{/if}}" data-toggle-players
        title="Show saved PC roster"><i class="fas fa-users"></i> Players</button>
      <select data-player-filter title="Player Selection" aria-label="Player Selection">
        <option value="">All PCs</option>
        {{#each players}}
          <option value="{{key}}" {{#if selected}}selected{{/if}}>{{actorName}}</option>
        {{/each}}
      </select>
      <button type="button" class="dt-view-pc-btn" data-view-pc title="Show selected PC damage history"
        {{#unless selectedHero}}disabled{{/unless}}><i class="fas fa-history"></i></button>
      {{#if isGM}}
        <button type="button" data-add-player class="dt-add-pc-btn" title="Add a PC, even without damage">
          <i class="fas fa-user-plus"></i> Add PC</button>
      {{/if}}
      <span class="dt-filter-divider" aria-hidden="true"></span>
      <select data-filter title="Show only this damage type">
        <option value="all" {{#if allSelected}}selected{{/if}}>All damage types</option>
        {{#each types}}
          <option value="{{key}}" {{#if selected}}selected{{/if}}>{{name}}</option>
        {{/each}}
      </select>
      <button type="button" data-toggle-types title="Configure tracked damage types" class="dt-settings-btn {{#if showTypes}}active{{/if}}"><i class="fas fa-sliders-h"></i></button>
    </div>
  </nav>
  {{#if showPlayers}}
    <section class="dt-player-panel">
      <div class="dt-player-panel-title">
        <b><i class="fas fa-users"></i> Registered Characters</b>
        <small>{{playerCount}} PCs · Click a character to see session history</small>
      </div>
      <div class="dt-player-list">
        {{#each players}}
          <div class="dt-player-item {{#if selected}}is-selected{{/if}}">
            <button type="button" class="dt-player-card" data-open-pc="{{key}}" title="Open {{actorName}} damage history">
              {{#if portrait}}
                <img src="{{portrait}}" alt="" loading="lazy">
              {{else}}<i class="fas fa-user-shield"></i>{{/if}}
              <span>{{actorName}}</span>
            </button>
            {{#if ../isGM}}
              {{#if registered}}
                <button type="button" class="dt-remove-pc" data-remove-pc="{{key}}"
                  title="Remove from registered list, keep damage records"><i class="fas fa-times"></i></button>
              {{/if}}
            {{/if}}
          </div>
        {{else}}
          <p class="dt-players-empty">No PCs yet. The GM can add an existing Actor or a custom PC name.</p>
        {{/each}}
      </div>
      {{#if isGM}}
        <div class="dt-session-settings">
          <label for="dt-current-session">Current Session <small>(new damage records)</small></label>
          <input id="dt-current-session" data-current-session maxlength="80" placeholder="e.g. Session 12"
            value="{{currentSession}}">
          <button type="button" data-save-current-session>Save Session</button>
        </div>
      {{/if}}
    </section>
  {{/if}}
  {{#if showTypes}}
    <section class="dt-type-panel">
      <div class="dt-panel-title">
        <b>Damage Types</b>
        <small>{{enabledCount}} / 14 enabled · {{#if isGM}}Uncheck a type to stop recording new damage of that type{{else}}GM manages these settings{{/if}}</small>
      </div>
      <div class="dt-types-grid">
        {{#each types}}
          <label class="dt-type-item"><input type="checkbox" data-enabled-type="{{key}}" {{#if checked}}checked{{/if}} {{#unless ../isGM}}disabled{{/unless}}> {{name}}</label>
        {{/each}}
      </div>
      <p class="dt-panel-note">13 official 5e damage types + Other / Unknown for rolls whose type cannot be determined reliably. Changes do not erase existing history.</p>
    </section>
  {{/if}}
  {{#if selectedHero}}
    <div class="dt-selected-pc">
      <span><i class="fas fa-user-circle"></i> Viewing {{selectedHero.actorName}}</span>
      <button type="button" data-view-pc><i class="fas fa-history"></i> Open Damage History</button>
    </div>
  {{/if}}
  <main class="dt-content">
    <section class="dt-champion">
      <div class="dt-label">✦ {{metricName}}</div>
      {{#if first}}
        <div class="dt-holder">♛ Current Record Holder</div>
        <div class="dt-champion-identity">
          <button type="button" class="dt-champion-link" data-open-pc="{{first.heroKey}}"
            title="Open {{first.actorName}} damage history"><h2>{{first.actorName}}</h2></button>
          {{#if first.portrait}}
            <img class="dt-champion-art" src="{{first.portrait}}" alt="{{first.actorName}} token art" loading="lazy">
          {{/if}}
        </div>
        <div class="dt-top-score">{{first.amountText}} <span>DMG</span></div>
        <p class="dt-sub">{{first.detail}}</p>
        <div class="dt-win">★ #1 IN CAMPAIGN</div>
      {{else}}
        {{#if selectedHero}}
          <h2>{{selectedHero.actorName}}</h2>
          <p class="dt-sub">This PC is saved. No damage has been recorded yet.</p>
          <button type="button" class="dt-zero-history" data-view-pc>View Character History</button>
        {{else}}
          <h2>No records yet</h2>
          <p class="dt-sub">Confirmed applied damage will appear here when tracking is enabled.</p>
        {{/if}}
      {{/if}}
    </section>
    <section class="dt-leaderboard">
      <header><b>🏆 Leaderboard</b><span>{{leaders.length}} heroes</span></header>
      <div class="dt-rows">
        {{#each leaders}}
          <div class="dt-row">
            <div class="dt-rank">{{#if crowned}}♛{{else}}{{rank}}{{/if}}</div>
            {{#if ../isGM}}
              <button type="button" class="dt-avatar dt-avatar-picker" data-portrait-key="{{portraitKey}}" title="Change {{actorName}} artwork" aria-label="Change artwork for {{actorName}}">
                {{#if portrait}}
                  <img src="{{portrait}}" alt="{{actorName}} token art" loading="lazy">
                {{else}}
                  <span>{{initial}}</span>
                {{/if}}
                <i class="fas fa-camera dt-avatar-camera" aria-hidden="true"></i>
              </button>
            {{else}}
              <div class="dt-avatar">
                {{#if portrait}}
                  <img src="{{portrait}}" alt="{{actorName}} token art" loading="lazy">
                {{else}}
                  <span>{{initial}}</span>
                {{/if}}
              </div>
            {{/if}}
            <div class="dt-character">
              <button type="button" class="dt-hero-link" data-open-pc="{{heroKey}}"
                title="Open {{actorName}} damage history"><b>{{actorName}}</b></button>
              <small>{{detail}}</small>
            </div>
            <div class="dt-amount"><b>{{amountText}}</b><small>DMG</small></div>
            {{#if ../isGM}}
              <button type="button" class="dt-pencil" data-records="{{dataKey}}" title="View and edit records"><i class="fas fa-pencil-alt"></i></button>
            {{/if}}
          </div>
        {{else}}
          <div class="dt-empty">No recorded damage for the selected category.</div>
        {{/each}}
      </div>
    </section>
  </main>
  <footer class="dt-foot">
    <div class="dt-foot-copy"><b>⚙ Record Manager</b><small>{{count}} records · {{captureMode}}</small></div>
    {{#if isGM}}
      <div class="dt-actions"><button type="button" data-manage>Manage Records</button><button type="button" data-add class="dt-add">+ Add Record</button></div>
    {{else}}<span class="dt-view-only">View only</span>{{/if}}
  </footer>
</section>